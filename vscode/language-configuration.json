{
  "comments": { "lineComment": "//" },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["<", ">"]],
  "folding": { "offSide": false },
  "indentationRules": {
    "increaseIndentPattern": "^.*(\\{[^}\"]*|\\([^)\"]*|\\[[^\\]\"]*|<[A-Za-z][^>/]*>\\s*|=\\s*)$",
    "decreaseIndentPattern": "^\\s*(\\}|\\)|\\]|</[A-Za-z])"
  },
  "onEnterRules": [
    { "beforeText": "<(?!(?:area|base|br|col|embed|hr|img|input|link|meta|source|track|wbr)\\b)[A-Za-z][\\w-]*(?:[.#][^\\s<>/]*)*(?:\\s(?:[^<>\"\\'/{}]|\"[^\"]*\"|\\'[^\\']*\\'|\\{[^{}]*(?:\\{[^{}]*\\}[^{}]*)*\\})*)?>[^<]*$", "afterText": "^\\s*</[A-Za-z][\\w-]*\\s*>", "action": { "indent": "indentOutdent" } },
    { "beforeText": "^\\s*//.*$", "action": { "indent": "none", "appendText": "// " } }
  ]
}
