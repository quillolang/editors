    <contexts>
      <context name="Normal" attribute="Normal Text" lineEndContext="#stay">
        <DetectSpaces/>
        <RegExpr attribute="Shebang" String="^#!.*$" column="0"/>
        <Detect2Chars attribute="Comment" context="LineComment" char="/" char1="/"/>
        <Detect2Chars attribute="Comment" context="BlockComment" char="/" char1="*" beginRegion="Comment"/>
        <RegExpr attribute="Keyword" firstNonSpace="true" String="(import|client|preload|preconnect)(?=\s+(module\s+)?(&quot;[^&quot;]*&quot;|[^\s&quot;]+)\s+use\b)" context="Import"/>
        <RegExpr attribute="Keyword" firstNonSpace="true" String="(route|routes|mount)\b" context="RouteHead"/>
        <RegExpr attribute="Keyword" firstNonSpace="true" String="service\b" context="ServiceHead"/>
        <!-- `public server fn x()`: server after private or public starts its definition too. -->
        <RegExpr attribute="Keyword" firstNonSpace="true" String="(private|public)(?=[ \t]+server\b\s+fn\b)" context="VisibleServer"/>
        <RegExpr attribute="Keyword" firstNonSpace="true" String="(private|public|server|state|site|type|style)\b(?=\s+[A-Za-z_])"/>
        <RegExpr attribute="Keyword" firstNonSpace="true" String="build\b(?=\s+&quot;[^&quot;]*&quot;\s*=[^=])"/>
        <RegExpr attribute="Builtin" firstNonSpace="true" String="accept_calls\b(?=\s*\{)"/>
        <StringDetect attribute="Comment" context="HtmlComment" String="&lt;!--"/>
        <RegExpr attribute="Doctype" insensitive="true" String="&lt;!doctype\s+html\s*&gt;"/>
        <RegExpr attribute="Keyword" String="\b(fn|view|component)\b" context="DefinitionName"/>
        <keyword attribute="Keyword" String="keywords"/>
        <keyword attribute="Constant" String="literals"/>
        <keyword attribute="Type" String="types"/>
        <RegExpr attribute="Builtin" String="\b(print|str|int|float|dec|len|type_of|upper|lower|trim|split|join|contains|starts_with|ends_with|replace|slice|map|filter|find|any|all|reduce|sum|min|max|sort|sort_by|reverse|first|last|push|range|enumerate|keys|values|get|has|set|remove|merge|err|is_err|unwrap|raw|escape|url_encode|env|now|sleep|file|redirect|respond|read_file|write_file|random|random_int|uuid|abs|round|floor|ceil|sqrt|pow|unique|flatten|zip|take|drop|count|group_by|index_of|repeat|format_number|live|publish|watch|unwatched|delete_file|check_program|join_on|markdown|highlight|run_script|sql_name|sql_param|ask|notify|translations|locale_from|locale|with_locale|t|schedule|allow_cross_site|tenant|tenant_from|with_tenant|save_upload|read_upload|js|js_new|parallel|every|stream|events|listen|receive|url|css|sql|navigate|set_cookie|delete_cookie|session|set_session|end_session|sessions|renew_session|end_sessions|user_sessions|rate_limit|rate_limit_reset|security_headers|csp|csp_nonce|idempotent|args|cookie|cursor_index|defer|error|exit|filled|js_has|local_path|new_tenant|normalize|page_updated|platform|read_line|ready|run_after|site_headers|stdin|style_with|waiting|accept_calls|classes|files|markdown_page|confirm|mcp_token|mcp_tokens|revoke_mcp_token|about)\b(?=\s*\()"/>
        <RegExpr attribute="Builtin" String="\b(json|db|http|udp|channel|media|crypto|image|math|stats|vec|date|money|re|bit|later)(?=\.)"/>
        <RegExpr attribute="Function" String="\b[A-Za-z_]\w*(?=\s*\(|`)"/>
        <RegExpr attribute="Number" String="\b(0[xX][0-9a-fA-F_]+|\d[\d_]*(\.\d[\d_]*)?([eE][+-]?\d+)?m?)\b"/>
        <DetectChar attribute="String" context="String" char="&quot;"/>
        <DetectChar attribute="String" context="StringSingle" char="'"/>
        <DetectChar attribute="String" context="Template" char="`"/>
        <RegExpr attribute="Tag" String="&lt;/?[A-Za-z][\w-]*" context="Tag"/>
        <DetectChar attribute="Normal Text" context="Braces" char="{" beginRegion="Brace"/>
        <DetectIdentifier/>
      </context>
      <context name="Braces" attribute="Normal Text" lineEndContext="#stay">
        <DetectChar attribute="Normal Text" context="#pop" char="}" endRegion="Brace"/>
        <IncludeRules context="Normal"/>
      </context>
      <context name="DefinitionName" attribute="Normal Text" lineEndContext="#pop" fallthroughContext="#pop">
        <DetectSpaces/>
        <!-- `fn mcp total()`: mcp with a name after it on its line is the tag of a tool; `fn mcp(x)`
             names a function mcp (quillo FEEDBACK56.md, Q-853). -->
        <RegExpr attribute="Keyword" String="mcp(?=[ \t]+[A-Za-z_])"/>
        <RegExpr attribute="Function" String="[A-Za-z_]\w*" context="#pop"/>
      </context>
      <context name="VisibleServer" attribute="Normal Text" lineEndContext="#pop" fallthroughContext="#pop">
        <DetectSpaces/>
        <RegExpr attribute="Keyword" String="server\b" context="#pop"/>
      </context>
      <context name="HtmlComment" attribute="Comment" lineEndContext="#stay">
        <StringDetect attribute="Comment" context="#pop" String="--&gt;"/>
      </context>
      <context name="LineComment" attribute="Comment" lineEndContext="#pop"/>
      <context name="BlockComment" attribute="Comment" lineEndContext="#stay">
        <Detect2Chars attribute="Comment" context="#pop" char="*" char1="/" endRegion="Comment"/>
      </context>
      <context name="Import" attribute="Normal Text" lineEndContext="#pop">
        <DetectSpaces/>
        <RegExpr attribute="Keyword" String="module\b"/>
        <RegExpr attribute="Path" String="(&quot;[^&quot;]*&quot;|[^\s&quot;]+)(?=\s+use\b)"/>
        <RegExpr attribute="Keyword" String="use\b" context="#pop"/>
      </context>
      <context name="RouteHead" attribute="Normal Text" lineEndContext="#pop" fallthroughContext="#pop">
        <DetectSpaces/>
        <RegExpr attribute="Constant" String="(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS|ANY)\b"/>
        <RegExpr attribute="Path" String="/[^\s{=?|]*" context="#pop"/>
        <DetectIdentifier attribute="Normal Text" context="#pop"/>
      </context>
      <!-- `service mcp /billing = ...`, `service mcp crm = ...`: the tag, with a path or a name after it;
           `service mcp = ...` and `service mcp /* note */ = ...` name a service mcp. -->
      <context name="ServiceHead" attribute="Normal Text" lineEndContext="#pop" fallthroughContext="#pop">
        <DetectSpaces/>
        <RegExpr attribute="Keyword" String="mcp(?=[ \t]+([A-Za-z_]|/(?![/*])))"/>
        <IncludeRules context="RouteHead"/>
      </context>
      <context name="String" attribute="String" lineEndContext="#stay">
        <RegExpr attribute="Escape" String="\\(u\{[0-9a-fA-F]+\}|u[0-9a-fA-F]{4}|.)"/>
        <DetectChar attribute="String" context="#pop" char="&quot;"/>
      </context>
      <context name="StringSingle" attribute="String" lineEndContext="#stay">
        <RegExpr attribute="Escape" String="\\(u\{[0-9a-fA-F]+\}|u[0-9a-fA-F]{4}|.)"/>
        <DetectChar attribute="String" context="#pop" char="'"/>
      </context>
      <context name="Template" attribute="String" lineEndContext="#stay">
        <RegExpr attribute="Escape" String="\\(u\{[0-9a-fA-F]+\}|u[0-9a-fA-F]{4}|.)"/>
        <Detect2Chars attribute="Interpolation" context="Substitution" char="$" char1="{"/>
        <DetectChar attribute="String" context="#pop" char="`"/>
      </context>
      <context name="Substitution" attribute="Normal Text" lineEndContext="#stay">
        <DetectChar attribute="Interpolation" context="#pop" char="}"/>
        <IncludeRules context="Normal"/>
      </context>
      <context name="Tag" attribute="Tag" lineEndContext="#stay">
        <DetectSpaces/>
        <Detect2Chars attribute="Tag" context="#pop" char="/" char1="&gt;"/>
        <DetectChar attribute="Tag" context="#pop" char="&gt;"/>
        <RegExpr attribute="Attribute" String="[.#][\w\-:]+"/>
        <RegExpr attribute="Attribute" String="[@:]?[A-Za-z_][\w\-:@.]*"/>
        <DetectChar attribute="Normal Text" char="=" context="AttributeValue"/>
        <DetectChar attribute="Normal Text" context="Braces" char="{"/>
      </context>
      <context name="AttributeValue" attribute="Normal Text" lineEndContext="#pop" fallthroughContext="#pop">
        <DetectChar attribute="String" context="#pop!String" char="&quot;"/>
        <DetectChar attribute="String" context="#pop!StringSingle" char="'"/>
        <DetectChar attribute="Normal Text" context="#pop!Braces" char="{"/>
        <RegExpr attribute="String" context="#pop" String="([^\s&quot;'=&lt;&gt;`{}/]|/(?!&gt;))+"/>
      </context>
    </contexts>
    <itemDatas>
      <itemData name="Normal Text" defStyleNum="dsNormal"/>
      <itemData name="Keyword" defStyleNum="dsKeyword"/>
      <itemData name="Function" defStyleNum="dsFunction"/>
      <itemData name="Builtin" defStyleNum="dsBuiltIn"/>
      <itemData name="Constant" defStyleNum="dsConstant"/>
      <itemData name="Type" defStyleNum="dsDataType"/>
      <itemData name="Number" defStyleNum="dsDecVal"/>
      <itemData name="String" defStyleNum="dsString"/>
      <itemData name="Escape" defStyleNum="dsSpecialChar"/>
      <itemData name="Interpolation" defStyleNum="dsSpecialChar"/>
      <itemData name="Path" defStyleNum="dsVerbatimString"/>
      <itemData name="Comment" defStyleNum="dsComment"/>
      <itemData name="Shebang" defStyleNum="dsPreprocessor"/>
      <itemData name="Doctype" defStyleNum="dsPreprocessor"/>
      <itemData name="Tag" defStyleNum="dsKeyword"/>
      <itemData name="Attribute" defStyleNum="dsAttribute"/>
    </itemDatas>
  </highlighting>
  <general>
    <comments>
      <comment name="singleLine" start="//"/>
      <comment name="multiLine" start="/*" end="*/" region="Comment"/>
    </comments>
    <keywords casesensitive="1"/>
  </general>
</language>
