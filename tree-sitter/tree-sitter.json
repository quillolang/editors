{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "quillo",
      "camelcase": "Quillo",
      "title": "Quillo",
      "scope": "source.quillo",
      "path": ".",
      "file-types": ["qwe"],
      "injection-regex": "^(quillo|qwe)$",
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "locals": "queries/locals.scm"
    }
  ],
  "metadata": {
    "version": "0.2.0",
    "license": "MIT",
    "description": "Quillo grammar for tree-sitter",
    "authors": [{ "name": "Quillo" }],
    "links": { "repository": "https://github.com/quillolang/editors" }
  },
  "bindings": { "c": false, "go": false, "node": false, "python": false, "rust": false, "swift": false, "zig": false }
}
