{
	"cmd": ["quillo", "run", "$file", "--watch"],
	"selector": "source.quillo",
	"working_dir": "$file_path",
	"file_regex": "^(.+\\.qwe):([0-9]+):?([0-9]+)?:? (.*)$",
	"variants": [
		{ "name": "Check", "cmd": ["quillo", "check", "$file"] },
		{ "name": "Run once", "cmd": ["quillo", "run", "$file"] },
	],
}
