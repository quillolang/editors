<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>comment</key>
	<string>A .qwer file: Rust (VS Code's own grammar), with its `//! [dependencies]` header as TOML.</string>
	<key>fileTypes</key>
	<array>
		<string>qwer</string>
	</array>
	<key>name</key>
	<string>Quillo Rust</string>
	<key>patterns</key>
	<array>
		<dict>
			<key>include</key>
			<string>#dependencies</string>
		</dict>
		<dict>
			<key>include</key>
			<string>source.rust</string>
		</dict>
	</array>
	<key>repository</key>
	<dict>
		<key>dependencies</key>
		<dict>
			<key>begin</key>
			<string>^\s*(//!)\s*(\[)(dependencies)(\])</string>
			<key>beginCaptures</key>
			<dict>
				<key>1</key>
				<dict>
					<key>name</key>
					<string>comment.line.documentation.rust</string>
				</dict>
				<key>2</key>
				<dict>
					<key>name</key>
					<string>punctuation.definition.table.toml</string>
				</dict>
				<key>3</key>
				<dict>
					<key>name</key>
					<string>entity.name.section.toml</string>
				</dict>
				<key>4</key>
				<dict>
					<key>name</key>
					<string>punctuation.definition.table.toml</string>
				</dict>
			</dict>
			<key>name</key>
			<string>meta.dependencies.qwer</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>captures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>support.type.property-name.toml</string>
						</dict>
						<key>2</key>
						<dict>
							<key>name</key>
							<string>keyword.operator.assignment.toml</string>
						</dict>
					</dict>
					<key>match</key>
					<string>([A-Za-z0-9_-]+)\s*(=)</string>
				</dict>
				<dict>
					<key>begin</key>
					<string>"</string>
					<key>end</key>
					<string>"|$</string>
					<key>name</key>
					<string>string.quoted.double.toml</string>
					<key>patterns</key>
					<array>
						<dict>
							<key>match</key>
							<string>\\.</string>
							<key>name</key>
							<string>constant.character.escape.toml</string>
						</dict>
					</array>
				</dict>
				<dict>
					<key>match</key>
					<string>\b(true|false)\b</string>
					<key>name</key>
					<string>constant.language.boolean.toml</string>
				</dict>
				<dict>
					<key>match</key>
					<string>\b[0-9][0-9_.]*\b</string>
					<key>name</key>
					<string>constant.numeric.toml</string>
				</dict>
				<dict>
					<key>match</key>
					<string>[{}]</string>
					<key>name</key>
					<string>punctuation.definition.table.inline.toml</string>
				</dict>
				<dict>
					<key>match</key>
					<string>[\[\],]</string>
					<key>name</key>
					<string>punctuation.definition.array.toml</string>
				</dict>
			</array>
			<key>while</key>
			<string>^\s*(//!)</string>
			<key>whileCaptures</key>
			<dict>
				<key>1</key>
				<dict>
					<key>name</key>
					<string>comment.line.documentation.rust</string>
				</dict>
			</dict>
		</dict>
	</dict>
	<key>scopeName</key>
	<string>source.qwer</string>
</dict>
</plist>
